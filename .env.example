# ── Flask Configuration ──
FLASK_SECRET_KEY=your-production-secret-key
FLASK_PORT=5004
FLASK_DEBUG=0

# ── Cybergate Integration ──
CYBERGATE_ENABLED=1
CYBERGATE_GATEWAY_ONLY=0
CYBERGATE_HOST=http://cybergate-web:5000
CYBERGATE_APP_NAME=CONVERTER LAPORAN DINASAN
CYBERGATE_APP_DESCRIPTION=Tool untuk konversi mentahan laporan Excel menjadi format laporan dinasan (NOC/SA) secara otomatis
CYBERGATE_APP_ICON=fa-file-signature
CYBERGATE_APP_ORDER=3
CYBERGATE_API_SECRET=